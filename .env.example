# Copy to .env.local after the Google account/property is set up. Never put secrets
# in a VITE_ variable: Vite includes those variables in public website JavaScript.
VITE_GA4_ENABLED=false
VITE_GA4_MEASUREMENT_ID=
# Leave false on normal development previews, so test visits do not inflate traffic.
VITE_GA4_ALLOW_LOCAL=false

# Private dashboard only. This is the numeric Property ID, NOT the G-... ID.
GA4_PROPERTY_ID=
# Prefer user Application Default Credentials where possible (see ANALYTICS_SETUP.md).
GA4_USE_ADC=false
# Alternative: path to an owner-authorized Viewer service-account JSON file OUTSIDE
# the repository. Use forward slashes in a Windows path. Do not paste JSON here.
GOOGLE_APPLICATION_CREDENTIALS=
ANALYTICS_PORT=4175
