{
  "name": "lucky-interiors-furniture",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "review": "node review-dashboard/server.mjs",
    "import:approved": "node scripts/import-approved-products.mjs",
    "generate:seo": "node generate-seo.mjs",
    "build": "npm run generate:seo && vite build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "lucide-react": "^0.555.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.39.0",
    "@vitejs/plugin-react": "^5.1.1",
    "vite": "^7.2.4",
    "wrangler": "^4.95.0"
  }
}
